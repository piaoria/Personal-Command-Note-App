{
  "name": "figma-make-app",
  "productName": "CommandNote",
  "description": "개인 명령어와 작업 순서를 보관하는 Windows 노트 앱",
  "private": true,
  "version": "1.3.2",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "setup:desktop": "install-electron",
    "dev:desktop": "electron-vite dev",
    "build:desktop": "npm run typecheck && electron-vite build",
    "preview:desktop": "electron-vite preview",
    "pack:desktop": "npm run build:desktop && electron-builder --win --x64 --dir",
    "dist:win": "npm run build:desktop && electron-builder --win nsis --x64",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.electron.json",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "npm run build:desktop && electron tests/electron-smoke.cjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
